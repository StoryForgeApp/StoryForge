{
  "name": "storyforge-electrobun",
  "version": "0.1.4",
  "description": "Storyforge written in Electrobun with React, Tailwind CSS, and Vite HMR",
  "scripts": {
    "build:canary": "vite build && electrobun build --env=canary",
    "build:dev": "vite build && electrobun build",
    "build:stable": "vite build && electrobun build --env=stable",
    "dev": "electrobun dev --watch",
    "dev:hmr": "bun run --parallel \"hmr\" \"electrobun dev --watch\"",
    "format": "bun run --parallel \"oxlint --fix\" oxfmt",
    "format:github": "bun run --parallel \"oxlint --fix --format=github\" \"oxfmt --check\"",
    "hmr": "vite --port 5173",
    "lint": "bun run --parallel \"oxlint\" \"oxfmt --check\"",
    "prepare": "husky",
    "release": "bumpp",
    "start": "vite build && electrobun dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@holmlibs/unzip": "^1.0.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/query-async-storage-persister": "^5.90.24",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-hotkeys": "^0.4.1",
    "@tanstack/react-hotkeys-devtools": "^0.4.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "@tanstack/react-router": "^1.166.7",
    "@tanstack/react-router-devtools": "^1.166.7",
    "@tanstack/react-virtual": "^3.13.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.15.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.0.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.5.5",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/react-form-devtools": "^0.2.18",
    "@tanstack/router-plugin": "^1.166.7",
    "@types/bun": "1.3.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "bumpp": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "oxlint-tsgolint": "^0.16.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  }
}
