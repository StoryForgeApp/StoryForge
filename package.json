{
  "name": "storyforge-electrobun",
  "version": "0.1.9",
  "description": "Storyforge written in Electrobun with React, Tailwind CSS, and Vite HMR",
  "scripts": {
    "build:canary": "vite build && electrobun build --env=canary",
    "build:dev": "vite build && electrobun build",
    "build:stable": "vite build && electrobun build --env=stable",
    "dev": "electrobun dev --watch",
    "dev:hmr": "bun run --parallel \"hmr\" \"start\"",
    "format": "bun run --parallel \"oxlint --fix\" oxfmt",
    "format:github": "bun run --parallel \"oxlint --fix --format=github\" \"oxfmt --check\"",
    "hmr": "vite --port 5173",
    "lint": "bun run --parallel \"oxlint\" \"oxfmt --check\"",
    "prepare": "husky",
    "release": "bumpp --commit --tag --push",
    "start": "vite build && electrobun dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@holmlibs/unzip": "^1.0.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/query-async-storage-persister": "^5.100.9",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-hotkeys-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electrobun": "1.18.1",
    "fflate": "^0.8.2",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "rcedit": "^5.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.6.0",
    "@tanstack/react-devtools": "^0.10.2",
    "@tanstack/react-form-devtools": "^0.2.22",
    "@tanstack/router-plugin": "^1.167.34",
    "@types/bun": "1.3.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bumpp": "^11.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "patchedDependencies": {
    "electrobun@1.18.1": "patches/electrobun@1.18.1.patch"
  }
}
